{
  "project": "LawyerLink",
  "description": "Legal consultation platform with AI assistance",
  "features": {
    "authentication": {
      "status": "done",
      "routes": {
        "POST /auth/register": "Register new user (client or lawyer)",
        "POST /auth/login": "Login and get JWT token",
        "POST /auth/logout": "Logout (blacklist token)",
        "POST /auth/forgot-password": "Request password reset",
        "GET /auth/reset-password/verify": "Verify reset token validity",
        "POST /auth/reset-password": "Reset password with token"
      }
    },
    "user": {
      "status": "done",
      "routes": {
        "GET /users/me": "Get current user profile",
        "PATCH /users/me": "Update basic profile fields (city, region)",
        "POST /users/me/image": "Upload profile picture",
        "DELETE /users/me/image": "Delete profile picture",
        "DELETE /users/me": "Delete user account"
      }
    },
    "chat": {
      "status": "done",
      "routes": {
        "POST /chat/session": "Create new AI chat session",
        "POST /chat/session/{session_id}/message": "Send message to AI chatbot",
        "GET /chat/session/{session_id}/history": "Get chat history",
        "GET /chat/session/{session_id}/specialty": "Get extracted legal specialty",
        "DELETE /chat/session/{session_id}": "Delete chat session",
        "POST /chat/admin/check-subscriptions": "Admin: check expired subscriptions"
      }
    },
    "recommendation": {
      "status": "done",
      "routes": {
        "GET /recommendations/session/{session_id}": "Get lawyer recommendations for session",
        "GET /recommendations/client": "Get all recommendations for client"
      }
    },
    "lawyer": {
      "status": "done",
      "routes": {
        "PATCH /lawyer/me": "Update lawyer profile (first_name, last_name, firm, license_number, specialties, languages, hourly_rate, city, region)",
        "GET /lawyer/me/reviews": "Get lawyer's own reviews",
        "GET /lawyer/me/reservations": "Get lawyer's appointments (query: status, date_from, date_to, limit)",
        "PATCH /lawyer/me/reservations/{reservation_id}": "Update reservation status (accept/reject/complete/cancel) or date/notes",
        "GET /lawyer/me/payments/history": "Get lawyer's payment history (query: date_from, date_to, payment_type)"
      }
    },
    "payment": {
      "status": "done",
      "routes": {
        "POST /payments/subscription": "Create subscription payment intent",
        "POST /payments/boost": "Create boost payment intent (query param: boost_level=1-5)",
        "GET /payments/history": "Lawyer payment history",
        "GET /payments/subscription/me": "Get active subscription status",
        "POST /payments/subscription/renew": "Renew subscription (create payment intent)",
        "POST /payments/subscription/cancel": "Cancel subscription",
        "POST /payments/test/simulate-success": "Test: simulate payment success (query params: transaction_id, payment_type)",
        "POST /payments/webhook": "Stripe webhook handler"
      }
    },
    "reservation": {
      "status": "done",
      "routes": {
        "POST /reservations": "Create booking request",
        "GET /reservations": "Get reservations (filtered by role: client or lawyer, query params: status, limit)",
        "GET /reservations/{reservation_id}": "Get single reservation",
        "PATCH /reservations/{reservation_id}": "Update reservation status/date/notes (role-based: clients cancel, lawyers accept/reject/complete)",
        "DELETE /reservations/{reservation_id}": "Cancel pending reservation (client only)"
      }
    },
    "review": {
      "status": "done",
      "routes": {
        "POST /reviews": "Submit review after completed reservation",
        "GET /reviews/lawyer/{lawyer_id}": "Get lawyer's reviews (public)",
        "GET /reviews/me": "Get current client's reviews",
        "GET /reviews/reservation/{reservation_id}": "Get review by reservation ID",
        "PATCH /reviews/{review_id}": "Update own review (within 7 days)",
        "DELETE /reviews/{review_id}": "Delete own review (within 7 days)",
        "GET /reviews/admin/all": "Admin: get all reviews"
      }
    }
  },
  "root_endpoints": {
    "GET /": "Root health check",
    "GET /health": "Health check"
  },
  "static_files": {
    "/uploads": "Serves uploaded profile pictures"
  }
}
