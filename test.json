{
  "project": "LawyerLink",
  "description": "Legal consultation platform with AI assistance",
  "features": {
    "authentication": {
      "status": "done",
      "routes": {
        "POST /auth/register": "Register new user (client or lawyer)",
        "POST /auth/login": "Login and get JWT token",
        "POST /auth/logout": "Logout (blacklist token)",
        "POST /auth/forgot-password": "Request password reset",
        "GET /auth/reset-password/verify": "Verify reset token validity",
        "POST /auth/reset-password": "Reset password with token"
      }
    },
    "user": {
      "status": "done",
      "routes": {
        "GET /users/me": "Get current user profile",
        "POST /users/me/image": "Upload profile picture",
        "DELETE /users/me/image": "Delete profile picture",
        "DELETE /users/me": "Delete user account"
      }
    },
    "chat": {
      "status": "done",
      "routes": {
        "POST /chat/session": "Create new AI chat session",
        "POST /chat/session/{session_id}/message": "Send message to AI chatbot",
        "GET /chat/session/{session_id}/history": "Get chat history",
        "GET /chat/session/{session_id}/specialty": "Get extracted legal specialty",
        "DELETE /chat/session/{session_id}": "Delete chat session",
        "POST /chat/admin/check-subscriptions": "Admin: check expired subscriptions"
      }
    },
    "recommendation": {
      "status": "done",
      "routes": {
        "GET /recommendations/session/{session_id}": "Get lawyer recommendations for session",
        "GET /recommendations/client": "Get all recommendations for client"
      }
    },
    "user_update": {
      "status": "missing",
      "routes": {
        "PUT /users/me": "Update user profile (city, region)"
      }
    },
    "lawyer": {
      "status": "pending",
      "routes": {
        "GET /lawyers": "List/search lawyers (with filters)",
        "GET /lawyers/{lawyer_id}": "Get lawyer profile details",
        "PUT /lawyers/me": "Update lawyer profile",
        "GET /lawyers/me/dashboard": "Lawyer dashboard stats"
      }
    },
    "payment": {
      "status": "done",
      "routes": {
        "POST /payments/subscription": "Purchase subscription",
        "POST /payments/boost?boost_level=1-5": "Pay to boost profile",
        "GET /payments/history": "User payment history",
        "GET /payments/subscription/me": "Get active subscription",
        "POST /payments/subscription/renew": "Renew subscription",
        "POST /payments/subscription/cancel": "Cancel subscription",
        "POST /payments/test/simulate-success": "Test: simulate payment success",
        "POST /payments/webhook": "Stripe webhook handler"
      }
    },
    "reservation": {
      "status": "pending",
      "routes": {
        "POST /reservations": "Create booking request",
        "GET /reservations/me": "Client's reservations",
        "GET /reservations/lawyer/me": "Lawyer's bookings",
        "PUT /reservations/{id}/accept": "Accept reservation",
        "PUT /reservations/{id}/reject": "Reject reservation",
        "PUT /reservations/{id}/complete": "Mark as completed",
        "DELETE /reservations/{id}": "Cancel reservation"
      }
    },
    "review": {
      "status": "pending",
      "routes": {
        "POST /reviews": "Submit review after reservation",
        "GET /reviews/lawyer/{lawyer_id}": "Get lawyer's reviews",
        "PUT /reviews/{id}": "Update own review",
        "DELETE /reviews/{id}": "Delete own review"
      }
    }
  },
  "root_endpoints": {
    "GET /": "Root health check",
    "GET /health": "Health check"
  }
}